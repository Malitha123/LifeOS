[Unit]
Description=LifeOS public MCP node — second tailscaled with Funnel on its 443 to the MCP HTTP transport
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__LIFEOS_DIR__
EnvironmentFile=-__LIFEOS_DIR__/.env
ExecStart=/usr/sbin/tailscaled --tun=userspace-networking --statedir=%h/.local/share/lifeos-mcp-ts --socket=%t/lifeos-mcp-ts.sock --port=0
ExecStartPost=-__LIFEOS_DIR__/scripts/mcp-funnel-node.sh apply
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
